# ---------- secrets ----------
.env
.env.*
!.env.example
.secrets/
*.pem
*-key.json
sa-key.json

# ---------- python ----------
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# ---------- uv ----------
# Keep uv.lock committed. Ignore only the cache.
.uv/

# ---------- dbt ----------
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/profiles.yml

# ---------- terraform ----------
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/terraform.tfvars.example

# ---------- node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- evidence ----------
evidence/.evidence/
evidence/node_modules/
evidence/build/

# ---------- sprint prompts ----------
# `prompt-<slug>.md` at repo root is the scoping / reviewer-brief
# artifact per AGENTS.md's Sprints section. It's authored locally,
# never committed. The PR body + commit message are the durable
# historical record.
# Anchored to the root so a stray `docs/prompt-*.md` (unlikely but
# defensible) wouldn't be silently ignored.
/prompt-*.md

# ---------- editor / os ----------
.DS_Store
.vscode/
.idea/
*.swp
*.swo
