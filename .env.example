# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# BigQuery
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_EVENTS=github.events

# GitHub API
# Optional token raises rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# OpenLineage
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=streaming-lakehouse
